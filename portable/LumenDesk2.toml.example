# LumenDesk 绿色版配置模板
#
# 用法：把本文件复制为同目录下的 LumenDesk2.toml，填入真实的服务器地址与公钥。
# 程序启动时若发现 exe 同级存在 config 目录，会把配置与日志都写入该目录，
# 不写 AppData、不碰注册表，整个文件夹可直接拷贝到其他机器。
#
# 注意：不要提交填好真实值的 LumenDesk2.toml（仓库是公开的）。

rendezvous_server = ""
nat_type = 0
serial = 0

[options]
# 信令/ID 服务器，域名或 IP + 端口。地址里带冒号时，程序不会追加默认端口 21116
custom-rendezvous-server = "__SERVER__:__RENDEZVOUS_PORT__"
# hbbs 生成的公钥（id_ed25519.pub 的内容）
key = "__PUBKEY__"
# 中继服务器（hbbr），显式写出避免解析失败。留空则由 hbbs 通过 -r 下发
relay-server = "__SERVER__:__RELAY_PORT__"
# 端口结构（hbbs -p P）：NAT 探测 = P-1，主服务 = P，WebSocket = P+2
# 端口结构（hbbr -p Q）：主服务 = Q，WebSocket = Q+2
# 本项目非默认端口：P=29016（29015/29016/29018），Q=29017（29017/29019）
